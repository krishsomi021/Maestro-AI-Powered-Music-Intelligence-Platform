# PostgreSQL
POSTGRES_USER=jobsuser
POSTGRES_PASSWORD=jobspassword
POSTGRES_DB=jobsdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# App
APP_ENV=development
LOG_LEVEL=info
