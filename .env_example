POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

APP_ENV=
LOG_LEVEL=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# LLM
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
AGENT_MODEL=claude-haiku-4-5
AGENT_JUDGE_MODEL=claude-sonnet-4-6
AGENT_MAX_ITERATIONS=6

# Agent behavior
AGENT_SQL_TIMEOUT_MS=5000
AGENT_SQL_ROW_CAP=200
AGENT_MEMORY_TTL_SECONDS=86400
AGENT_MAX_MESSAGES=20
AGENT_LOCAL_TZ=America/New_York

# Agent read-only PostgreSQL role
AGENT_READONLY_DB_USER=agent_readonly
AGENT_READONLY_DB_PASSWORD=
